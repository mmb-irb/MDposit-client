    "canvas": "^3.2.3",
    "http": "npm:stream-http@3.2.0",
    "jest-image-snapshot": "6.1.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "1.18.2",
    "typescript": "^6.0.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "workbox-build": "4.3.1"
  },
  "scripts": {
    "start": "npm run hostlink && vite",
    "dev_build": "npm run hostlink && vite build --sourcemap && node style-embedder/index.js && node sw-build/index.js",
    "build": "npm run hostlink && vite build && node style-embedder/index.js && node sw-build/index.js",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest",
    "hostlink": "custom=host-config.js; default=default-host-config.js; [ -f src/$custom ] && source=$custom || source=$default; ln -fs ../../$source src/utils/constants/host-config.js"
  },
  "lint-staged": {
    "src/**/*.{js,json,css}": [
      "prettier --single-quote --write"
    ]
  },
  "overrides": {
    "molstar": {
      "@types/express": {
        "@types/express-serve-static-core": "4.17.30"
      },
      "canvas": "$canvas"
    },
    "d3-color": "3.1.0",
    "@types/d3-dispatch": "^1.0.12",
    "underscore": "^1.13.8",
    "@tootallnate/once": "^2.0.1",
    "serialize-javascript": "^7.0.5"
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@fortawesome/fontawesome-common-types": false,
    "@scarf/scarf": false,
    "canvas@3.2.3": true,
    "esbuild": false
  }
}
